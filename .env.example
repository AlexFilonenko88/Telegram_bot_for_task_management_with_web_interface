# =============================================================================
# Пример файла .env. Скопируйте в .env и подставьте свои значения:
#   cp .env.example .env
# =============================================================================

# --- Telegram-бот (нужен боту; API использует только BOT_SECRET) --------------
BOT_TOKEN=your_telegram_bot_token_here
API_URL=https://your-railway-app-url.railway.app
BOT_SECRET=your_secret_key_here

# --- Режим бота: polling (по умолчанию) или webhook ---------------------------
USE_WEBHOOK=false
WEBHOOK_URL=https://your-railway-app-url.railway.app

# --- PostgreSQL (для docker compose, сервис db) -------------------------------
# Образ postgres читает эти три переменные при первичной инициализации БД.
POSTGRES_DB=taskbot
POSTGRES_USER=taskbot
POSTGRES_PASSWORD=change-me-strong-password

# --- Строка подключения FastAPI-приложения к БД -------------------------------
# В docker compose хост БД — имя сервиса "db" (внутренняя сеть tasknet).
# Пароль должен совпадать с POSTGRES_PASSWORD выше.
DATABASE_URL=postgresql://taskbot:change-me-strong-password@db:5432/taskbot

# --- Локальная разработка без Docker (SQLite, можно просто удалить строку) ----
# DATABASE_URL=sqlite:///./tasks.db

# --- Алерты в Telegram (п.20, опционально; для scripts/notify_telegram.sh) ----
# ОТДЕЛЬНЫЙ бот для алертов (не боевой BOT_TOKEN выше): создать через
# @BotFather -> /newbot. Не заданы — уведомления просто не отправляются.
#TELEGRAM_ALERT_BOT_TOKEN=123456789:AA...alert-bot-token
#TELEGRAM_ALERT_CHAT_ID=123456789
