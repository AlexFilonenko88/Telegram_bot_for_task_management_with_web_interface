# =============================================================================
# .dockerignore — исключения из контекста сборки Docker.
# Контекст — taskbot/, поэтому отсекаем всё, что не нужно образу FastAPI:
# меньше контекст => быстрее сборка и меньше шансов протащить лишнее в образ.
# =============================================================================

# Секреты и локальные БД — в образ попадать не должны
.env
*.db
*.sqlite3

# Виртуальные окружения (зависимости ставятся внутри контейнера)
venv/
.venv/

# Кэши Python
__pycache__/
*.pyc
*.pyo

# Код Telegram-бота: в образе только FastAPI-бэкенд и статика фронтенда
bot/

# Docker-инфраструктура и документация — в контексте сборки не нужны
Dockerfile
docker-compose.yml
docker-compose.yaml
.dockerignore
*.md

# Служебные файлы
.git
.gitignore
scripts/
